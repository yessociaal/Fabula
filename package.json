{
  "name": "fabula",
  "version": "0.1.0",
  "private": true,
  "description": "A visual editor that exports normal Ren'Py games",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dev:web": "vite --config vite.web.config.ts",
    "test:renpy": "node scripts/lint-fixture.mjs",
    "test:e2e": "node scripts/e2e-export.mjs",
    "test:typing": "node scripts/terminal-typing.mjs",
    "test:screens": "node scripts/test-screens.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xyflow/react": "^12.12.1",
    "electron": "^45.3.2",
    "electron-vite": "^6.0.0",
    "immer": "^11.2.10",
    "lucide-react": "^1.73.0",
    "nanoid": "^6.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zod": "^4.6.7",
    "zundo": "^2.3.0",
    "zustand": "^5.1.0"
  }
}
